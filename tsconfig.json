{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noUncheckedIndexedAccess": true, "skipLibCheck": true,
    "esModuleInterop": true, "resolveJsonModule": true, "allowImportingTsExtensions": true,
    "noEmit": true, "lib": ["ES2022", "DOM"], "types": ["node"],
    "forceConsistentCasingInFileNames": true
  },
  "include": ["backend/src/**/*.ts", "backend/test/**/*.ts"],
  "exclude": ["node_modules", "legacy"]
}
